+writeability_check() {
+    expected_phase=${1:-auto}
+    mode=$(get meta primary_mode)
+    primaries_writable=yes
+    primaries_fenced=yes
+    for i in $(ids); do
+        role=$(sql "$i" "SELECT MEMBER_ROLE FROM performance_schema.replication_group_members WHERE MEMBER_ID=@@server_uuid;")
+        state=$(sql "$i" "SELECT MEMBER_STATE FROM performance_schema.replication_group_members WHERE MEMBER_ID=@@server_uuid;")
+        ro=$(val "$i" read_only); sro=$(val "$i" super_read_only)
+        [ "$state" = ONLINE ] || die "Node $i is not ONLINE while checking writeability (state=$state)"
+        case "$mode:$role" in
+            single:PRIMARY|multi:PRIMARY)
+                [ "$ro" = 0 ] && [ "$sro" = 0 ] || primaries_writable=no
+                [ "$sro" = 1 ] || primaries_fenced=no
+                ;;
+            single:SECONDARY)
+                [ "$sro" = 1 ] || die "Node $i SECONDARY is writable (read_only=$ro super_read_only=$sro)"
+                ;;
+            multi:SECONDARY) die "Multi-primary node $i unexpectedly reports SECONDARY";;
+            *) die "Unexpected topology while checking writeability: node=$i mode=$mode role=$role";;
+        esac
+    done
+    if [ "$primaries_writable" = yes ]; then
+        WRITEABILITY_STATE=released
+    elif [ "$primaries_fenced" = yes ]; then
+        WRITEABILITY_STATE=fenced
+    else
+        die 'PRIMARY writeability is inconsistent across the group; expected all writable or all intentionally fenced.'
+    fi
+    case "$expected_phase:$WRITEABILITY_STATE" in
+        auto:*) :;;
+        released:released|fenced:fenced) :;;
+        *) die "Writeability state mismatch: expected=$expected_phase actual=$WRITEABILITY_STATE";;
+    esac
+}
